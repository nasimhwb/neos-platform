[Unit]
Description=Biometric Device Raw Packet TCP Listener (Port 8005)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/biometric
ExecStart=/usr/bin/python3 /opt/biometric/biometric_listener.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
