# ==============================================================================
# NEOS PLATFORM - SHARED INFRASTRUCTURE ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and configure the secrets for production.
# DO NOT commit the .env file containing actual passwords/secrets to Git.

# ------------------------------------------------------------------------------
# SYSTEM SETTINGS
# ------------------------------------------------------------------------------
# Set to 'production' on the VPS, 'development' for local testing
ENVIRONMENT=production
TIMEZONE=UTC
TRAEFIK_VERSION=latest

# ------------------------------------------------------------------------------
# DASHBOARD CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_PLATFORM_NAME=NEOS Platform
DASHBOARD_SECRET=ChangeThisToASuperSecretDashboardKeyAtLeast32Chars!
DASHBOARD_DB_PASSWORD=ChangeThisToASecureDashboardDbPassword!

# ------------------------------------------------------------------------------
# DOMAINS AND NETWORKING
# ------------------------------------------------------------------------------
# Base domain name for the VPS deployment
BASE_DOMAIN=neos-platform.local

# Subdomains for individual services
ERP_SUBDOMAIN=erp.neos-platform.local
CRM_SUBDOMAIN=crm.neos-platform.local
HRMS_SUBDOMAIN=hrms.neos-platform.local
BILLING_SUBDOMAIN=billing.neos-platform.local
INVENTORY_SUBDOMAIN=inventory.neos-platform.local
MINIO_API_SUBDOMAIN=s3.neos-platform.local
MINIO_CONSOLE_SUBDOMAIN=s3-console.neos-platform.local
MONITORING_SUBDOMAIN=monitor.neos-platform.local

# Mapped hostnames for routing configuration
DASHBOARD_DOMAIN=dashboard.neosfacility.com
API_DOMAIN=supabase.neosfacility.com
GRAFANA_DOMAIN=monitor.neosfacility.com
MINIO_DOMAIN=s3.neosfacility.com
MINIO_CONSOLE_DOMAIN=console.s3.neosfacility.com
STATUS_DOMAIN=status.neosfacility.com

# Let's Encrypt certificate email
ACME_EMAIL=info@neosfacility.com

# ------------------------------------------------------------------------------
# POSTGRESQL DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
POSTGRES_VERSION=16.3-alpine
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=ChangeThisToASuperSecurePostgresSuperuserAdminPassword123!

# Multi-tenant DB definition format: db_name:db_user:db_password
# Separate multiple databases by commas. The init script will create them automatically.
POSTGRES_MULTIPLE_DATABASES=neos_erp:erp_user:erp_pass_123,neos_crm:crm_user:crm_pass_123,neos_hrms:hrms_user:hrms_pass_123,neos_billing:billing_user:billing_pass_123,neos_inventory:inventory_user:inventory_pass_123,neos_app:neos_app_user:ChangeThisToASecureNeosAppPassword123!

# Database Tuning (Default values for VPS with 4GB RAM)
# Adjust these based on actual VPS resources in postgres/postgresql.conf
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=1GB
POSTGRES_EFFECTIVE_CACHE_SIZE=3GB
POSTGRES_WORK_MEM=10MB
POSTGRES_MAINTENANCE_WORK_MEM=256MB

# ------------------------------------------------------------------------------
# REDIS CONFIGURATION
# ------------------------------------------------------------------------------
REDIS_VERSION=7.2-alpine
REDIS_PASSWORD=ChangeThisToASuperSecureRedisPassword456!
REDIS_MAXMEMORY=512mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# ------------------------------------------------------------------------------
# MINIO OBJECT STORAGE CONFIGURATION
# ------------------------------------------------------------------------------
MINIO_VERSION=RELEASE.2024-06-06T09-36-42Z
MINIO_ROOT_USER=neos_storage_admin
MINIO_ROOT_PASSWORD=ChangeThisToASuperSecureMinioRootPassword789!

# ------------------------------------------------------------------------------
# MONITORING STACK
# ------------------------------------------------------------------------------
GRAFANA_VERSION=11.0.0
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=ChangeThisToASuperSecureGrafanaPassword321!

PROMETHEUS_VERSION=v2.52.0
LOKI_VERSION=3.0.0
PROMTAIL_VERSION=3.0.0

# ------------------------------------------------------------------------------
# BACKUP CONFIGURATION
# ------------------------------------------------------------------------------
# Retain backups locally for this many days
BACKUP_RETENTION_DAYS=14
# Target directory for local backups on the host
BACKUP_DIR=/srv/neos/backups

# Cloud Backup Credentials (rclone) - Configure if offsite backup is enabled
RCLONE_REMOTE_NAME=b2-backups
RCLONE_BUCKET_NAME=neos-backups-bucket

# ------------------------------------------------------------------------------
# SMTP CONFIGURATION
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.placeholder_password_for_prod_gotrue
